# ==============================================================================
# PowerGrid Defect Priority Management System — Environment Configuration
# ==============================================================================

# Application Security
# Generate a strong key e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Database Connection (MySQL 8.0+ InnoDB recommended)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://powergrid_user:powergrid@localhost:3306/power_db

# Database Connection Pool Options (Optional defaults shown)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# SMTP & Mail Configuration (Optional - for reminders and password reset)
# Note: Can also be dynamically configured via the Admin Settings UI
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password

# Background Scheduler & Debug Mode
ENABLE_SCHEDULER=True
FLASK_DEBUG=False
